rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * One submission belongs to exactly one Firebase UID.
     * Students can read their own submission and edit it
     * only while each section is still unsubmitted.
     */
    match /submissions/{submissionId} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid;

      allow read: if request.auth != null
                  && request.auth.uid == resource.data.ownerUid;

      allow update: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && (
                      resource.data.arithmetic.status.submitted == false
                      || request.resource.data.arithmetic == resource.data.arithmetic
                    )
                    && (
                      resource.data.geometry.status.submitted == false
                      || request.resource.data.geometry == resource.data.geometry
                    )
                    && (
                      resource.data.evaluation.status.submitted == false
                      || request.resource.data.evaluation == resource.data.evaluation
                    );

      allow delete: if false;
    }

    /* Retry tokens are server-only. Students never query this collection directly. */
    match /retrySessions/{retryToken} {
      allow read, write: if false;
    }

    /* Deny every other collection by default. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
